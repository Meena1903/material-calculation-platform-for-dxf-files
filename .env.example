# SkillBridge POC — copy to backend/.env and fill your keys

APP_NAME=SkillBridge
APP_ENV=development
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=

DATABASE_URL=

# NVIDIA NIM — get from https://build.nvidia.com/nim (login → model → Get API Key)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_EMBEDDING_MODEL=
NVIDIA_CHAT_MODEL=

W_RELEVANCE=0.40
W_TRUST=0.15
W_AUTHORITY=0.15
W_FRESHNESS=0.15
W_ENGAGEMENT=0.15
SPAM_PENALTY=0.30
COLD_START_INTERACTIONS=5
