# ==============================================================================
# BuildIQ AI — Automated Pile Foundation Takeoff Engine
# Runtime Configuration  →  Copy this file to backend/.env and fill in secrets
# ==============================================================================

# 1. Core Application
APP_NAME="BuildIQ AI - Automated Pile Foundation Takeoff Engine"
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Allowed CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# 2. Frontend (Vite)
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# 3. NVIDIA NIM Multimodal Vision API
# Get your key from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BACKUP_VISION_MODEL=mistralai/pixtral-12b-2409

# 4. Civil Engineering Calculation Constants (IS 1786 / SP 34)
DEFAULT_CLEAR_COVER_MM=50.0
DEFAULT_CONCRETE_GRADE=M35
DEFAULT_STEEL_GRADE=Fe500D
UNIT_WEIGHT_STEEL_DENOMINATOR=162.28
DEFAULT_CONCRETE_WASTAGE_FACTOR=1.05

# 5. Manpower / Labor Productivity Ratios
MANPOWER_PILING_CONCRETE_PER_M3=0.25
MANPOWER_REBAR_PER_MT=2.50
MANPOWER_CHIPPING_PER_PILE=0.50

# 6. File Storage & Upload Size Limit
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
CROPS_DIR=outputs/crops
MAX_UPLOAD_SIZE_MB=500
