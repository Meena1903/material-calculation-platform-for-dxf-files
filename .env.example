# ==============================================================================
# BuildIQ AI — Automated Pile Foundation Takeoff Engine
# Unified Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Configuration
# ------------------------------------------------------------------------------
APP_NAME="BuildIQ AI - Automated Pile Foundation Takeoff Engine"
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Allowed CORS Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 2. Frontend (Vite + React) Configuration
# ------------------------------------------------------------------------------
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. NVIDIA NIM Multimodal & AI APIs
# Get your API key from https://build.nvidia.com/
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BACKUP_VISION_MODEL=mistralai/pixtral-12b-2409

# ------------------------------------------------------------------------------
# 4. Vector Database (Milvus Lite / Semantic Similarity)
# ------------------------------------------------------------------------------
MILVUS_URI=./milvus_pile_takeoff.db
MILVUS_COLLECTION_NAME=pile_foundation_schedules
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# 5. Graph Database (Neo4j Aura / Structural Relationships)
# ------------------------------------------------------------------------------
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# 6. Civil Engineering Standards & Calculation Parameters
# ------------------------------------------------------------------------------
DEFAULT_CLEAR_COVER_MM=50.0
DEFAULT_CONCRETE_GRADE=M35
DEFAULT_STEEL_GRADE=Fe500D
UNIT_WEIGHT_STEEL_DENOMINATOR=162.28  # IS 1786 unit weight formula: d^2 / 162.28 kg/m
DEFAULT_CONCRETE_WASTAGE_FACTOR=1.05 # 5% overage allowance for soil overbreak

# ------------------------------------------------------------------------------
# 7. Manpower & Labor Productivity Estimation Ratios
# ------------------------------------------------------------------------------
MANPOWER_PILING_CONCRETE_PER_M3=0.25  # 0.25 Man-Days per m³ concrete
MANPOWER_REBAR_PER_MT=2.50            # 2.50 Man-Days per MT steel
MANPOWER_CHIPPING_PER_PILE=0.50       # 0.50 Man-Days per pile

# ------------------------------------------------------------------------------
# 8. File Storage & Output Directories
# ------------------------------------------------------------------------------
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
CROPS_DIR=outputs/crops
