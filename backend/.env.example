# BuildIQ AI Automated Pile Foundation Takeoff Engine
# Environment Configuration

APP_NAME="BuildIQ AI - Automated Pile Foundation Takeoff Engine"
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Settings (Allow Frontend development servers)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# NVIDIA NIM API Configuration
# Get your API key from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Civil Engineering Constants & Calculation Parameters
DEFAULT_CLEAR_COVER_MM=50.0
DEFAULT_CONCRETE_GRADE=M35
DEFAULT_STEEL_GRADE=Fe500D
UNIT_WEIGHT_STEEL_DENOMINATOR=162.28

# Manpower Estimation Ratios (Man-Days)
MANPOWER_PILING_CONCRETE_PER_M3=0.25
MANPOWER_REBAR_PER_MT=2.50
MANPOWER_CHIPPING_PER_PILE=0.50
