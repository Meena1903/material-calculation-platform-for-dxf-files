# Application
APP_NAME=SkillBridge
APP_ENV=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite for POC; swap to Postgres URL for production)
DATABASE_URL=sqlite+aiosqlite:///./skillbridge.db

# NVIDIA NIM (from https://build.nvidia.com/nim)
# Get key: login → pick model → Get API Key
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_CHAT_MODEL=meta/llama-3.1-8b-instruct

# Ranking weights (tunable)
W_RELEVANCE=0.40
W_TRUST=0.15
W_AUTHORITY=0.15
W_FRESHNESS=0.15
W_ENGAGEMENT=0.15
SPAM_PENALTY=0.30

# Cold-start threshold
COLD_START_INTERACTIONS=5
